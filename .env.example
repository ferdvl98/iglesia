DATABASE_URL="postgresql://usuario:password@host:5432/actas_iglesia?schema=public"
AUTH_SECRET="genera-un-valor-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Tope de usuarios activos. El precio es por parroquia, no por usuario, así que
# esto es una baranda —evita que una diócesis meta varias parroquias en una
# instancia pagada como una— y no una palanca de precio. Sin la variable no hay
# tope. Se configura en Vercel, fuera del alcance del cliente.
LICENCIAS_USUARIOS="25"

# Módulos que se contratan aparte. Vienen DESACTIVADOS: una instalación nueva
# nace sin ellos y se encienden al instalarlos.
MODULO_PUNTO_DE_VENTA="false"

# Monitoreo de errores. Sin esta variable no se inicializa nada: la aplicación
# funciona igual y el desarrollo local no manda ruido al panel. Se configura
# por instancia, de modo que cada cliente reporta por separado y se sabe a qué
# parroquia avisar.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
