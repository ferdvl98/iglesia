DATABASE_URL="postgresql://usuario:password@host:5432/actas_iglesia?schema=public"
AUTH_SECRET="genera-un-valor-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Usuarios activos contratados por el cliente. Se configura en Vercel, no
# en la aplicación, para que el administrador de la parroquia no pueda
# ampliarse el cupo. Sin esta variable no hay tope.
LICENCIAS_USUARIOS="10"
